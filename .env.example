# Copy to .env. Everything has a default; AWS is off until you enable it.
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SNS_TOPIC_ARN=
SNS_MIN_SEVERITY=MEDIUM
CW_LOG_GROUP=/logpulse/alerts
CW_LOG_STREAM=anomaly-alerts

# Detection tuning
WINDOW_SECONDS=10
BASELINE_MIN_SAMPLES=20
SIGMA_LOW=1
SIGMA_MEDIUM=2
SIGMA_HIGH=3
SIGMA_CRITICAL=5
MIN_DELTA=0.03
CONFIRM_TICKS=3
RESOLVE_TICKS=5

# Simulator
SIM_RPS=20
SIM_BASE_ERROR=0.02
SIM_SPIKE_ERROR=0.30
